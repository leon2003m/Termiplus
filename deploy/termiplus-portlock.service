# Locks every terminal's bridge port to its own MAC the moment the port
# appears (deploy/firewall.sh --watch-ports): learning off, port locked and
# a static FDB entry, so one terminal cannot forge another's MAC and receive
# the gateway's replies to it. Needs Linux and iproute2 >= 6.2.
#
#   sudo cp deploy/termiplus-portlock.service /etc/systemd/system/
#   sudo systemctl edit termiplus-portlock   # only if the path below differs
#   sudo systemctl enable --now termiplus-portlock.service
[Unit]
Description=termiplus bridge port lock watcher
After=docker.service
Requires=docker.service

[Service]
Type=simple
ExecStart=/opt/termiplus/deploy/firewall.sh --watch-ports
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
