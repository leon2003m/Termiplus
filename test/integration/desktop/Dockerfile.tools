# Test-only image. Never used by shipped desktop builds or deployment examples.
ARG BASE=termiplus-desktop:codex-theme
FROM ${BASE}
USER 0
RUN apt-get update && apt-get install -y --no-install-recommends \
        xdotool wmctrl x11-utils xclip python3-pyatspi at-spi2-core \
        tesseract-ocr tesseract-ocr-eng tesseract-ocr-deu \
    && rm -rf /var/lib/apt/lists/*
USER 1000:1000
ENV QT_ACCESSIBILITY=1
