#!/bin/sh
# Entrypoint of the terminal image. Docker writes its embedded resolver
# (127.0.0.11) into /etc/resolv.conf even when the gateway pins a terminal to
# the internal DNS forwarder, and gVisor cannot reach that resolver
# (google/gvisor#7469). When the gateway passes the forwarder in
# OPEN_TERMINAL_RESOLVER, point resolv.conf straight at it. This is a
# convenience, not a boundary: the firewall decides where DNS may go.
set -eu
resolver="${OPEN_TERMINAL_RESOLVER:-}"
unset OPEN_TERMINAL_RESOLVER
if [ -n "$resolver" ]; then
  if echo "$resolver" | grep -Eq '^[0-9]{1,3}(\.[0-9]{1,3}){3}$'; then
    printf 'nameserver %s\noptions ndots:0\n' "$resolver" | sudo -n tee /etc/resolv.conf >/dev/null ||
      echo "start: could not point /etc/resolv.conf at $resolver" >&2
  else
    echo "start: ignoring malformed OPEN_TERMINAL_RESOLVER" >&2
  fi
fi
# Under Sysbox the workspace can run its own Docker daemon once the user has
# installed it. Start it if present, and tell the model in the tool
# description.
if grep -q sysboxfs /proc/self/mountinfo 2>/dev/null; then
  if command -v dockerd >/dev/null 2>&1; then
    /usr/local/bin/start-docker >/dev/null || echo "start: could not start dockerd" >&2
  fi
  OPEN_TERMINAL_EXECUTE_DESCRIPTION="${OPEN_TERMINAL_EXECUTE_DESCRIPTION:-} Docker works in this container: if it is missing, run sudo apt-get update && sudo apt-get install -y docker.io, then start-docker. Afterwards docker works without sudo and starts by itself after a restart."
  export OPEN_TERMINAL_EXECUTE_DESCRIPTION
fi
exec "$@"
