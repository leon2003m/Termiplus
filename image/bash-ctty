#!/usr/bin/python3 -I
"""Start bash with the terminal as its controlling TTY.

Open Terminal starts $SHELL as the leader of a new session on a fresh PTY but
never makes that PTY the session's controlling terminal, so the shell runs
without job control (no Ctrl+Z, fg, bg; "no job control in this shell").
Only the session leader itself can acquire it, so do that here and then
replace this process with bash. Arguments are passed through unchanged.
"""
import fcntl
import os
import sys
import termios

if os.isatty(0):
    try:
        fcntl.ioctl(0, termios.TIOCSCTTY, 0)
    except OSError:
        pass  # not a session leader or already has a terminal: start bash anyway

os.execv("/bin/bash", ["bash", *sys.argv[1:]])
